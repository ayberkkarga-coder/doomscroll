{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      { "when": ["gui", "ground", "fixed", "on_shelf"],
        "model": { "type": "minecraft:model", "model": "doomscroll:item/tablet_icon" } }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "doomscroll:item/tablet",
      "model": { "type": "doomscroll:tablet" }
    }
  }
}
